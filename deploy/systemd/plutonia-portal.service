[Unit]
Description=Plutonia Portal
After=network.target postgresql.service

[Service]
Type=simple
User=python
Group=python
WorkingDirectory=/home/python/demos/plutonia_v3
Environment=PLUTONIA_ROOT=/home/python/demos/plutonia_v3
EnvironmentFile=/home/python/demos/plutonia_v3/.env
ExecStart=/home/python/demos/plutonia_v3/scripts/run_portal.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
