[Unit]
Description=Plutonia Portal
After=network.target postgresql.service

[Service]
Type=simple
User=python
Group=python
WorkingDirectory=/home/python/demos/plutonia/ainews
Environment=PLUTONIA_ROOT=/home/python/demos/plutonia/ainews
EnvironmentFile=/home/python/demos/plutonia/ainews/.env
ExecStart=/home/python/demos/plutonia/ainews/scripts/run_portal.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
